# Copy this file to .env.local and fill in the values. Never commit .env.local or any real value.
# On Vercel, add the same variables under the project → Settings → Environment Variables.
# They are read when the site is built: after changing them, rebuild (run-local.bat does) or redeploy.

# Production site URL, used for canonical URLs, the sitemap and Open Graph images.
# Leave it empty locally (http://localhost:3002 is used). On Vercel, empty falls back to the project's production domain.
SITE_URL=

# Contact form → email, through a Google Apps Script web app (setup: docs/CONTACT-SETUP.md).
# Server-only: never add a NEXT_PUBLIC_ prefix. Until both are set, the site shows "Email me instead".
# The Google Apps Script web app URL (it ends with /exec). Mark it "Sensitive" in Vercel.
CONTACT_WEBHOOK_URL=
# A long random secret (64 hex characters; at least 16). The same value goes in the script's CONTACT_SECRET
# property. docs/CONTACT-SETUP.md shows how to make a new one.
CONTACT_SECRET=

# Résumé (scripts/resume): no variables needed. SITE_URL sets the portfolio URL printed on it. The private version
# reads the phone number from the CV in the nicofiles folder (outside the repo) at run time; it is never stored here.
